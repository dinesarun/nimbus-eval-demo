# Copy this file to .env and fill in ONE provider. .env is git-ignored; never commit real keys.

# --- Option A: Azure OpenAI (model names below = your deployment names)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Option B: OpenAI
# OPENAI_API_KEY=sk-...

# --- Option C: Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Models for the bot under test and for the LLM judge
BOT_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
