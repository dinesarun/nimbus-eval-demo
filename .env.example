# Copy this file to .env and fill in ONE provider (A, B or C). Leave the others commented out.
# .env is git-ignored. Never commit real keys.
# If more than one key is set, the first one found wins: Azure, then OpenAI, then Anthropic.

# --- Option A: Azure OpenAI ---------------------------------------------------
# Needs a gpt-4o deployment (model version 2024-08-06 or newer).
# Find these in Azure AI Foundry -> Deployments -> your deployment.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Option B: OpenAI -----------------------------------------------------------
# OPENAI_API_KEY=sk-...

# --- Option C: Anthropic (Claude) --------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Models (optional) ---------------------------------------------------------------
# Defaults: gpt-4o for Azure and OpenAI, claude-opus-5 for Anthropic.
# On Azure, this is your DEPLOYMENT name. Set it only if your deployment isn't called "gpt-4o".
# BOT_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o
